PORT=port
DATABASE_URL=postgres://user:password@postgres:5432/CompensationDB

# Datos del colaborador y de su contrato vigente (líquido pagable referencial para el tope de descuento).
EMPLOYEE_SERVICE_URL=http://employee-service:3002
EMPLOYEE_SERVICE_TIMEOUT_MS=5000
ATTENDANCE_SERVICE_URL=http://attendance-service:3004

# Pub/Sub: cierre de ventas del periodo publicado por Ventas y Marketing (grupo E), en
# projects/project-a96e5fe1-5ba6-4698-a85/topics/ucb-sis323-sub-e. Con GOOGLE_APPLICATION_CREDENTIALS usa esa
# cuenta de servicio contra el proyecto real; con PUBSUB_EMULATOR_HOST usa el emulador local en su lugar. Sin
# ninguna de las dos, el consumidor no se inicia y los eventos no se reciben (quedan pendientes en Ventas).
PUBSUB_PROJECT_ID=project-a96e5fe1-5ba6-4698-a85
GOOGLE_APPLICATION_CREDENTIALS=/credentials/<llave-cuenta-servicio>.json
PUBSUB_EMULATOR_HOST=
PUBSUB_TOPICO_VENTAS=ucb-sis323-sub-e
PUBSUB_SUFIJO_SUSCRIPCION=-rrhh-productividad
