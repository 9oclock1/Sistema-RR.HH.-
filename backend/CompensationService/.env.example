PORT=port
DATABASE_URL=postgres://user:password@postgres:5432/CompensationDB
# Mismo valor que JWT_SECRET de AuthService: verifica la sesión en /boletas (KAN-66).
JWT_SECRET=secretWord

# Datos del colaborador y de su contrato vigente (líquido pagable referencial para el tope de descuento).
EMPLOYEE_SERVICE_URL=http://employee-service:3002
EMPLOYEE_SERVICE_TIMEOUT_MS=5000
ATTENDANCE_SERVICE_URL=http://attendance-service:3004
# Pub/Sub (KAN-63): la planilla aprobada (y el aguinaldo, KAN-67) se publica en el tópico propio de RRHH;
# Contabilidad (D) y Pagos (A) responden en sus tópicos y se leen con suscripciones propias (<tópico><sufijo>).
# Desarrollo local: PUBSUB_EMULATOR_HOST + PUBSUB_PROJECT_ID contra el emulador del docker-compose
# (servicio pubsub-emulator); el tópico propio se crea solo al arrancar el servicio. Producción: en vez de
# PUBSUB_EMULATOR_HOST, GOOGLE_APPLICATION_CREDENTIALS con la llave de la cuenta de servicio en la carpeta
# credentials (no se sube al repo). Sin ninguna, los eventos quedan en la bandeja de salida hasta que haya Pub/Sub.
GOOGLE_APPLICATION_CREDENTIALS=
PUBSUB_EMULATOR_HOST=pubsub-emulator:8085
PUBSUB_PROJECT_ID=project-a96e5fe1-5ba6-4698-a85
PUBSUB_TOPICO=ucb-sis323-sub-f
PUBSUB_TIMEOUT_MS=15000
INTERVALO_EVENTOS_MS=5000
# Confirmaciones: tópicos de Contabilidad y Pagos que se leen, cada uno con la suscripción <tópico><sufijo>.
PUBSUB_TOPICOS_CONFIRMACION=ucb-sis323-sub-d,ucb-sis323-sub-a
PUBSUB_SUFIJO_SUSCRIPCION=-rrhh-planillas
# Cierre de ventas del periodo publicado por Ventas y Marketing (grupo E), leído con la suscripción <tópico><sufijo>.
PUBSUB_TOPICO_VENTAS=ucb-sis323-sub-e
PUBSUB_SUFIJO_SUSCRIPCION_VENTAS=-rrhh-productividad

# Finiquitos (KAN-78): simulación asíncrona de las respuestas de Pagos (A) y Contabilidad (D) en el tópico F.
SIMULAR_RESPUESTAS_FINIQUITO=true
SIMULAR_RESPUESTAS_FINIQUITO_DEMORA_MS=3000
FINIQUITO_MAXIMO_INTENTOS=3
NOTIFICATION_SERVICE_URL=http://notification-service:3007

# Cierre definitivo de desvinculaciones (KAN-79): publicación en tópico F, plazos de revocación y AuthService.
SIMULAR_RESPUESTAS_CIERRE=true
SIMULAR_RESPUESTAS_CIERRE_DEMORA_MS=3000
REVOCACION_PLAZO_SEGUNDOS=45
REVOCACION_MAXIMO_REENVIOS=3
CIERRE_MAXIMO_INTENTOS=3
AUTH_SERVICE_URL=http://auth-service:3001
CLAVE_SERVICIOS_INTERNOS=cambie-esta-clave
