PORT=port
DATABASE_URL=postgres://user:password@postgres:5432/CompensationDB

# Datos del colaborador y de su contrato vigente (líquido pagable referencial para el tope de descuento).
EMPLOYEE_SERVICE_URL=http://employee-service:3002
EMPLOYEE_SERVICE_TIMEOUT_MS=5000
ATTENDANCE_SERVICE_URL=http://attendance-service:3004
# Pub/Sub (KAN-63): la planilla aprobada se publica en el tópico propio de RRHH; Contabilidad (D) y Pagos (A)
# responden en sus tópicos y se leen con suscripciones propias (<tópico><sufijo>). Llave de la cuenta de servicio en
# la carpeta credentials (no se sube al repo), o PUBSUB_EMULATOR_HOST + PUBSUB_PROJECT_ID para el emulador.
# Sin ninguna, la planilla aprobada queda en la bandeja de salida hasta que haya Pub/Sub.
GOOGLE_APPLICATION_CREDENTIALS=/credentials/<llave-cuenta-servicio>.json
PUBSUB_EMULATOR_HOST=
PUBSUB_PROJECT_ID=<id-proyecto-gcp>
PUBSUB_TOPICO=ucb-sis323-sub-f
PUBSUB_TIMEOUT_MS=15000
INTERVALO_EVENTOS_MS=5000
# Confirmaciones: tópicos de Contabilidad y Pagos que se leen, cada uno con la suscripción <tópico><sufijo>.
PUBSUB_TOPICOS_CONFIRMACION=ucb-sis323-sub-d,ucb-sis323-sub-a
PUBSUB_SUFIJO_SUSCRIPCION=-rrhh-planillas
# Cierre de ventas del periodo publicado por Ventas y Marketing (grupo E), leído con la suscripción <tópico><sufijo>.
PUBSUB_TOPICO_VENTAS=ucb-sis323-sub-e
PUBSUB_SUFIJO_SUSCRIPCION_VENTAS=-rrhh-productividad
