PORT=port
DATABASE_URL=postgres://user:password@postgres:5432/EmployeeDB

# Evidencia de memorándums (RF-37)
EVIDENCIA_DIR=uploads/evidencia
MAX_FILE_SIZE_MB=5

# PDF oficial del memorándum (RF-37): carpeta de salida y datos del membrete
MEMORANDUMS_PDF_DIR=uploads/memorandums_pdf
INSTITUCION_NOMBRE=<nombre-de-la-institucion>
INSTITUCION_UNIDAD=Gerencia de Recursos Humanos
INSTITUCION_PIE=<direccion-telefono-ciudad>
# ruta a un logo PNG o JPG
INSTITUCION_LOGO=

# PDF del memorándum de felicitación (RF-38): usa el mismo membrete
RECONOCIMIENTOS_PDF_DIR=uploads/reconocimientos_pdf