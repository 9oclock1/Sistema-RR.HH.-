PORT=port
DATABASE_URL=postgres://user:password@postgres:5432/AuthDB
# Firma los JWT de sesión. Debe ser igual en los servicios que verifican la sesión (CompensationService).
JWT_SECRET=secretWord
# Clave compartida con CompensationService para los endpoints internos de revocación de accesos.
CLAVE_SERVICIOS_INTERNOS=cambie-esta-clave
