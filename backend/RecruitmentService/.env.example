PORT=port
DATABASE_URL=postgres://user:password@postgres:5432/RecruitmentDB
EMPLOYEE_SERVICE_URL=http://employee-service:3002
EMPLOYEE_SERVICE_TIMEOUT_MS=5000
APP_TIMEZONE=America/La_Paz

# Storage Provider
# 'local' guarda en UPLOAD_DIR; 's3' en el bucket de OCI
STORAGE_DRIVER=local

# Configuración Local
UPLOAD_DIR=uploads/cvs
MAX_FILE_SIZE_MB=5

# Configuración OCI S3-Compatible
OCI_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_REGION=<region>
OCI_S3_BUCKET_NAME=<nombre-del-bucket>
OCI_S3_ACCESS_KEY_ID=<access-key-customer-secret>
OCI_S3_SECRET_ACCESS_KEY=<secret-key-customer-secret>
CDN_PUBLIC_URL=<url-cdn-publico>

# Extracción de datos del CV: 'local' (Ollama), 'cloud' (API) o 'regex' (heurística, sin LLM)
CV_PARSER_PROVIDER=local

# Ollama local
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=<modelo-ollama>

# API en la nube: 'google', 'openai' o 'anthropic'
CLOUD_PROVIDER=google
LLM_MODEL=<modelo-llm>
GOOGLE_API_KEY=<google-api-key>
OPENAI_API_KEY=<openai-api-key>
ANTHROPIC_API_KEY=<anthropic-api-key>
