PORT=port
DATABASE_URL=postgres://user:password@postgres:5432/RecruitmentDB
EMPLOYEE_SERVICE_URL=http://employee-service:3002
EMPLOYEE_SERVICE_TIMEOUT_MS=5000
APP_TIMEZONE=America/La_Paz

# sin URL queda pendiente en EVENTOS_SALIENTES. Contabilidad (D), Marketplace/POS (E), Inventarios (I), Entregas (H).
URL_CONTABILIDAD=
URL_MARKETPLACE_POS=
URL_INVENTARIOS=
URL_ENTREGAS=
INTEGRACION_TIMEOUT_MS=5000
INTERVALO_EVENTOS_MS=5000

# Pub/Sub: llave de la cuenta de servicio (carpeta credentials, no se sube al repo), o PUBSUB_EMULATOR_HOST +
# PUBSUB_PROJECT_ID para el emulador. Sin URL REST, el alta se publica en el tópico único de RRHH; sin Pub/Sub, queda pendiente.
GOOGLE_APPLICATION_CREDENTIALS=/credentials/<llave-cuenta-servicio>.json
PUBSUB_EMULATOR_HOST=
PUBSUB_PROJECT_ID=<id-proyecto-gcp>
PUBSUB_TOPICO=ucb-sis323-sub-f
PUBSUB_TIMEOUT_MS=15000

# RF-15: los correos al candidato los envía NotificationService (SMTP configurado allá); aquí queda la cola.
NOTIFICATION_SERVICE_URL=http://notification-service:3007
NOTIFICATION_SERVICE_TIMEOUT_MS=15000
CORREO_INTERVALO_MS=5000

# Storage Provider
# 'local' guarda en UPLOAD_DIR; 's3' en el bucket de OCI
STORAGE_DRIVER=local

# Configuración Local
UPLOAD_DIR=uploads/cvs
MAX_FILE_SIZE_MB=5

# Configuración OCI S3-Compatible
OCI_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_REGION=<region>
OCI_S3_BUCKET_NAME=<nombre-del-bucket>
OCI_S3_ACCESS_KEY_ID=<access-key-customer-secret>
OCI_S3_SECRET_ACCESS_KEY=<secret-key-customer-secret>
CDN_PUBLIC_URL=<url-cdn-publico>

# Extracción de datos del CV: 'local' (Ollama), 'cloud' (API) o 'regex' (heurística, sin LLM)
CV_PARSER_PROVIDER=local

# Ollama local
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=<modelo-ollama>
OLLAMA_MODEL_EMBEDDING=<modelo-ollama-embedding>

# API en la nube: 'google', 'openai' o 'anthropic'
CLOUD_PROVIDER=google
LLM_MODEL=<modelo-llm>
EMBEDDING_MODEL=<modelo-embedding>
GOOGLE_API_KEY=<google-api-key>
OPENAI_API_KEY=<openai-api-key>
ANTHROPIC_API_KEY=<anthropic-api-key>

# umbrales de similitud (0-1) para habilidades. Por defecto 0.78 exacto y 0.60 (local/regex) o 0.70 (cloud)
# AFFINITY_UMBRAL_EXACTO=0.78
# AFFINITY_UMBRAL_PARCIAL=0.70
