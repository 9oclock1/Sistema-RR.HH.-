PORT=port
DATABASE_URL=postgres://user:password@postgres:5432/AttendanceDB
EMPLOYEE_SERVICE_URL=http://employee-service:3002
EMPLEADOS_SIMULADOS=false
DISPOSITIVOS_BIOMETRICOS=BIO-CENTRAL-01:cambiar-esta-clave
DESCANSO_MINIMO_HORAS=11
AREAS_PRODUCCION=PROD,PAN,FRAC
AREAS_REPARTO=REPARTO,DESP
# Compensaciones es del mismo proyecto: sus eventos van por REST (POST a esta URL).
# Sin URL, CompensationService los lee con GET /eventos?topico=compensaciones.
URL_COMPENSACIONES=
# Pub/Sub (Producción y Logística, Entregas y Despachos): llave de la cuenta de servicio (no se sube al repo),
# o PUBSUB_EMULATOR_HOST + PUBSUB_PROJECT_ID para el emulador. Sin ninguna, los eventos quedan pendientes.
GOOGLE_APPLICATION_CREDENTIALS=
PUBSUB_EMULATOR_HOST=
PUBSUB_PROJECT_ID=
# Todo lo que sale de RRHH se publica en su tópico: <PUBSUB_PREFIJO_TOPICO> + letra del grupo (F), p. ej. ucb-sis323-sub-f.
# El destino de cada mensaje va en su encabezado, no en el tópico.
PUBSUB_PREFIJO_TOPICO=ucb-sis323-sub-
INTERVALO_EVENTOS_MS=5000
INTERVALO_CONTRASTE_MS=300000
MINUTOS_CIERRE_JORNADA=120
HORAS_PLAZO_JUSTIFICACION=48
MINUTOS_MINIMOS_EXTRA=15
