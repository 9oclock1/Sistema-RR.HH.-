PORT=port
DATABASE_URL=postgres://user:password@postgres:5432/PerformanceDB
EMPLOYEE_SERVICE_URL=http://employee-service:3002
EMPLOYEE_SERVICE_TIMEOUT_MS=3000
# Ciclos de evaluación (RF-03): tiempo máximo para pedir a EmployeeService el listado completo de colaboradores y cargos.
EMPLOYEE_SERVICE_LISTA_TIMEOUT_MS=8000
# Quejas (RF-68), obligatoria para registrar quejas: clave AES-256-GCM de 32 bytes en hex.
# Cada entorno genera la suya y nunca se sube al repositorio. Generarla con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUEJAS_CLAVE_CIFRADO=
QUEJAS_DIR=uploads/quejas
QUEJAS_CONSULTAS_MAXIMO=10
QUEJAS_CONSULTAS_VENTANA_MIN=15
# Derivación de quejas (RF-69): códigos de área (EmployeeService) cuyo personal puede atender quejas, separados por coma.
# Además del área de RRHH, también pueden ser responsables quienes tienen un cargo con subordinados (supervisores).
QUEJAS_AREAS_RRHH=RRHH
QUEJAS_ZONA_HORARIA=America/La_Paz
# Aviso al responsable: mensaje directo en la bandeja del portal (POST /comunicaciones/directa).
NOTIFICATION_SERVICE_URL=http://notification-service:3007
NOTIFICATION_SERVICE_TIMEOUT_MS=5000
# Ciclos de evaluación: job diario que activa ciclos, recuerda a los evaluadores a 3 días de la fecha límite y cierra los vencidos.
# También corre una vez al arrancar el servicio. CRON_CICLOS_ACTIVO=false lo desactiva.
CRON_CICLOS=0 8 * * *
CRON_CICLOS_ACTIVO=true
APP_TIMEZONE=America/La_Paz
# Al cerrar un ciclo, la solicitud de métricas al CRM se publica en el tópico único de RRHH (origen F, destino B).
# Llave de la cuenta de servicio (carpeta credentials, no se sube al repo), o PUBSUB_EMULATOR_HOST + PUBSUB_PROJECT_ID para el emulador.
# Sin ninguna de las dos, la solicitud queda PENDIENTE en la base.
GOOGLE_APPLICATION_CREDENTIALS=/credentials/<llave-cuenta-servicio>.json
PUBSUB_EMULATOR_HOST=
PUBSUB_PROJECT_ID=<id-proyecto-gcp>
PUBSUB_TOPICO=ucb-sis323-sub-f
PUBSUB_TIMEOUT_MS=15000
# Despachador de eventos salientes: cada cuántos milisegundos busca solicitudes pendientes. DESPACHO_EVENTOS_ACTIVO=false lo desactiva.
DESPACHO_EVENTOS_INTERVALO_MS=15000
DESPACHO_EVENTOS_ACTIVO=true
# Cargos (código en EmployeeService) cuyas métricas mide el CRM: los únicos colaboradores que viajan en la solicitud.
CRM_CARGOS_METRICAS=ATC-CAJ,ATC-ASE
# sistema simula la respuesta del CRM, la muestra en la consola y la procesa como si hubiera llegado por Pub/Sub.
# SIMULAR_CRM_ACTIVO=false desactiva esa simulación y el endpoint de simulación manual.
SIMULAR_CRM_ACTIVO=true
SIMULAR_CRM_DEMORA_MS=2000
# Entregas de un mismo mensaje del CRM antes de mandarlo a la cola de errores (DLQ), con espera creciente desde CRM_REINTENTO_BASE_MS.
CRM_MAXIMO_INTENTOS=5
CRM_REINTENTO_BASE_MS=1000
# Solo rotula la consola del navegador: el CRM responde desde su propio tópico.
PUBSUB_TOPICO_CRM=ucb-sis323-sub-b
