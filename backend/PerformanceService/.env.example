PORT=port
DATABASE_URL=postgres://user:password@postgres:5432/PerformanceDB
EMPLOYEE_SERVICE_URL=http://employee-service:3002
EMPLOYEE_SERVICE_TIMEOUT_MS=3000
# Quejas (RF-68), obligatoria para registrar quejas: clave AES-256-GCM de 32 bytes en hex.
# Cada entorno genera la suya y nunca se sube al repositorio. Generarla con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUEJAS_CLAVE_CIFRADO=
QUEJAS_DIR=uploads/quejas
QUEJAS_CONSULTAS_MAXIMO=10
QUEJAS_CONSULTAS_VENTANA_MIN=15