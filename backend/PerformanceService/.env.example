PORT=port
DATABASE_URL=postgres://user:password@postgres:5432/PerformanceDB
EMPLOYEE_SERVICE_URL=http://employee-service:3002
EMPLOYEE_SERVICE_TIMEOUT_MS=3000
# Quejas (RF-68): clave AES-256-GCM de 32 bytes en hex. Generarla con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUEJAS_CLAVE_CIFRADO=
QUEJAS_DIR=uploads/quejas
QUEJAS_CONSULTAS_MAXIMO=10
QUEJAS_CONSULTAS_VENTANA_MIN=15
# Derivación de quejas (RF-69): códigos de área (EmployeeService) cuyo personal puede atender quejas, separados por coma.
# Además del área de RRHH, también pueden ser responsables quienes tienen un cargo con subordinados (supervisores).
QUEJAS_AREAS_RRHH=RRHH
QUEJAS_ZONA_HORARIA=America/La_Paz
# Aviso al responsable: mensaje directo en la bandeja del portal (POST /comunicaciones/directa).
NOTIFICATION_SERVICE_URL=http://notification-service:3007
NOTIFICATION_SERVICE_TIMEOUT_MS=5000